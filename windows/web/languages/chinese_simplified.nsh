; Chinese Simplified Language Strings for SlimeVR Installer
; 简体中文语言字符串文件

; Page titles and subtitles
LangString START_PAGE_TITLE ${LANG_SIMPCHINESE} "欢迎"
LangString START_PAGE_SUBTITLE ${LANG_SIMPCHINESE} "欢迎使用 SlimeVR 安装程序！"

; Components page customization
LangString COMPONENTS_PAGE_TITLE ${LANG_SIMPCHINESE} "选择组件"
LangString COMPONENTS_PAGE_SUBTITLE ${LANG_SIMPCHINESE} "选择您要安装的 SlimeVR 功能"
LangString COMPONENTS_PAGE_TEXT_TOP ${LANG_SIMPCHINESE} "选择您要安装的组件，取消选择您不想安装的组件。点击下一步继续。"
LangString COMPONENTS_PAGE_TEXT_DESCRIPTION_TITLE ${LANG_SIMPCHINESE} "描述"
LangString COMPONENTS_PAGE_TEXT_DESCRIPTION_INFO ${LANG_SIMPCHINESE} "将鼠标悬停在组件上以查看其描述。"

; Directory page customization
LangString DIRECTORY_PAGE_TITLE ${LANG_SIMPCHINESE} "选择安装位置"
LangString DIRECTORY_PAGE_SUBTITLE ${LANG_SIMPCHINESE} "选择安装 SlimeVR 的文件夹"
LangString DIRECTORY_PAGE_TEXT_TOP ${LANG_SIMPCHINESE} "安装程序将在以下文件夹中安装 SlimeVR。要安装在不同的文件夹中，请点击浏览并选择其他文件夹。点击下一步继续。"
LangString DIRECTORY_PAGE_TEXT_DESTINATION ${LANG_SIMPCHINESE} "目标文件夹"

; Installation page customization
LangString INSTFILES_PAGE_TITLE ${LANG_SIMPCHINESE} "安装"
LangString INSTFILES_PAGE_SUBTITLE ${LANG_SIMPCHINESE} "正在安装 SlimeVR"

; Common button and dialog text
LangString BUTTON_NEXT ${LANG_SIMPCHINESE} "下一步(&N) >"
LangString BUTTON_BACK ${LANG_SIMPCHINESE} "< 上一步(&B)"
LangString BUTTON_CANCEL ${LANG_SIMPCHINESE} "取消"
LangString BUTTON_CLOSE ${LANG_SIMPCHINESE} "关闭(&C)"
LangString BUTTON_BROWSE ${LANG_SIMPCHINESE} "浏览(&B)..."

; Installation UI text
LangString EXISTING_INSTALLATION_DETECTED_1 ${LANG_SIMPCHINESE} "在 "
LangString EXISTING_INSTALLATION_DETECTED_2 ${LANG_SIMPCHINESE} " 检测到现有安装。请选择一个选项，然后点击下一步继续。"
LangString CLICK_NEXT_TO_PROCEED ${LANG_SIMPCHINESE} "点击下一步继续安装。"
LangString INSTALLATION_FINISHED ${LANG_SIMPCHINESE} "安装已完成！"
LangString UPDATE_OPTION ${LANG_SIMPCHINESE} "更新"
LangString REPAIR_OPTION ${LANG_SIMPCHINESE} "修复"

; Installation progress messages
LangString INSTALLING_SLIMEVR_SERVER ${LANG_SIMPCHINESE} "正在安装 SlimeVR 服务器..."
LangString INSTALLING_WEBVIEW2 ${LANG_SIMPCHINESE} "正在安装 webview2！"
LangString INSTALLING_JAVA_JRE ${LANG_SIMPCHINESE} "正在安装 Java JRE ${JREVersion}..."
LangString INSTALLING_STEAMVR_DRIVER ${LANG_SIMPCHINESE} "正在安装 SteamVR 驱动程序..."
LangString UNPACKING_FILES ${LANG_SIMPCHINESE} "正在解压文件..."
LangString UNZIPPING_FINISHED ${LANG_SIMPCHINESE} "解压完成，返回代码：$0。"
LangString INSTALLING_FINISHED ${LANG_SIMPCHINESE} "安装完成，返回代码：$0。"
LangString COPYING_SLIMEVR_SERVER ${LANG_SIMPCHINESE} "正在复制 SlimeVR 服务器到安装文件夹..."
LangString REMOVING_OLD_JAVA ${LANG_SIMPCHINESE} "正在移除旧的 Java JRE..."
LangString REMOVING_OLD_DRIVERS ${LANG_SIMPCHINESE} "正在从 SteamVR 配置中移除旧的外部驱动程序..."
LangString COPYING_STEAMVR_DRIVER ${LANG_SIMPCHINESE} "正在复制 SteamVR 驱动程序到 SteamVR..."
LangString UNZIPPING_JRE_FINISHED ${LANG_SIMPCHINESE} "JRE 解压完成，返回代码：$0。"

; Uninstall messages
LangString UNREGISTERING_INSTALLATION ${LANG_SIMPCHINESE} "正在注销安装..."
LangString UNINSTALL_DONE ${LANG_SIMPCHINESE} "完成。"

; Firewall messages
LangString ADDING_FIREWALL_EXCEPTION ${LANG_SIMPCHINESE} "正在添加 SlimeVR 服务器到防火墙例外..."
LangString REMOVING_FIREWALL_EXCEPTION ${LANG_SIMPCHINESE} "正在从防火墙例外中移除 SlimeVR 服务器..."
LangString REGISTERING_INSTALLATION ${LANG_SIMPCHINESE} "正在注册安装..."

; Component descriptions
LangString DESC_SEC_SERVER ${LANG_SIMPCHINESE} "安装最新的 SlimeVR 服务器。"
LangString DESC_SEC_JRE ${LANG_SIMPCHINESE} "复制 Java JRE 17 到安装文件夹。SlimeVR 服务器运行所必需。"
LangString DESC_SEC_WEBVIEW ${LANG_SIMPCHINESE} "如果尚未安装，则安装 Webview2。SlimeVR GUI 运行所必需。"
LangString DESC_SEC_VRDRIVER ${LANG_SIMPCHINESE} "安装最新的 SlimeVR SteamVR 驱动程序。"
LangString DESC_SEC_USBDRIVERS ${LANG_SIMPCHINESE} "各种开发板使用的 USB 驱动程序列表。"
LangString DESC_SEC_FEEDER_APP ${LANG_SIMPCHINESE} "安装 SlimeVR Feeder 应用，将 SteamVR 追踪器（Vive 追踪器、控制器）的位置发送到 SlimeVR 服务器。肘部追踪必需。"
LangString DESC_SEC_MSVCPP ${LANG_SIMPCHINESE} "安装最新的 Microsoft Visual C++ 可再发行组件版本（SteamVR 驱动程序和 SlimeVR Feeder 所需）"
LangString DESC_SEC_CP210X ${LANG_SIMPCHINESE} "安装 CP210X USB 驱动程序，适用于以下开发板：NodeMCU v2、Wemos D1 Mini。"
LangString DESC_SEC_CH340 ${LANG_SIMPCHINESE} "安装 CH340 USB 驱动程序，适用于以下开发板：NodeMCU v3、SlimeVR、Wemos D1 Mini。"
LangString DESC_SEC_CH9102x ${LANG_SIMPCHINESE} "安装 CH9102x USB 驱动程序，适用于以下开发板：NodeMCU v2.1。"

; Status and error messages
LangString DESC_STEAM_NOTFOUND ${LANG_SIMPCHINESE} "未检测到 Steam 安装。需要安装 Steam 和 SteamVR 并至少运行一次才能安装 SteamVR 驱动程序。"
LangString DESC_STEAMVR_RUNNING ${LANG_SIMPCHINESE} "SteamVR 正在运行！请关闭 SteamVR。"
LangString DESC_SLIMEVR_RUNNING ${LANG_SIMPCHINESE} "SlimeVR 正在运行！请关闭 SlimeVR。"
LangString DESC_PROCESS_ERROR ${LANG_SIMPCHINESE} "尝试查找 $0 时发生错误 nsProcess::FindProcess 返回 "

